---
import { profile } from "../content/site";
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() ?? "";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? "";
let secureEndpoint = false;
try {
  secureEndpoint = new URL(endpoint).protocol === "https:";
} catch {
  /* unconfigured */
}
const configured = secureEndpoint && !!siteKey;
---

<section
  id="kontakt"
  class="contact-section wrap"
  aria-labelledby="contact-title"
>
  <div class="contact-intro">
    <p class="eyebrow line-label">Kontakt</p>
    <h2 id="contact-title">
      Am Anfang
      <br />
      war die Mail.
    </h2>
    <p>
      Für erste Fragen und ein unverbindliches Kennenlernen. Bitte teilen Sie hier
      ausschließlich allgemeine Kontaktdaten.
    </p>
    {profile.email ? (
      <a class="text-link" href={`mailto:${profile.email}`}>
        {profile.email} ↗
      </a>
    ) : (
      <p class="content-note">
        E-Mail-Adresse wird vor Veröffentlichung ergänzt.
      </p>
    )}
    <p class="contact-emergency">
      Dieses Formular ist kein Notfallangebot.
      <br />
      Bei unmittelbarer Gefahr wähle bitte 112.
    </p>
  </div>
  <form
    id="contact-form"
    data-endpoint={configured ? endpoint : ""}
    data-site-key={configured ? siteKey : ""}
    aria-describedby="form-state"
    novalidate
  >
    <p id="form-state" class="form-state">
      {configured
        ? "Der Spam-Schutz wird erst nach deiner Aktivierung geladen. Dabei wird eine Verbindung zu Cloudflare hergestellt. Informationen findest du in den Datenschutzhinweisen."
        : "Entwicklungsstand: Das Kontaktformular ist noch nicht angeschlossen. Es werden keine Anfragen versendet."}
    </p>
    <div class="field">
      <label for="name">
        Name <span>(erforderlich)</span>
      </label>
      <input
        id="name"
        name="name"
        autocomplete="name"
        required
        minlength="2"
        maxlength="100"
        aria-describedby="name-error"
      />
      <span id="name-error" class="field-error"></span>
    </div>
    <div class="field">
      <label for="email">
        E-Mail-Adresse <span>(erforderlich)</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
        aria-describedby="email-error"
      />
      <span id="email-error" class="field-error"></span>
    </div>
    <div class="field">
      <label for="message">
        Nachricht <span>(optional · maximal 2.000 Zeichen)</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        maxlength="2000"
        aria-describedby="message-error"
      ></textarea>
      <span id="message-error" class="field-error"></span>
    </div>
    {configured && (
      <div class="spam-protection">
        <button id="load-turnstile" class="text-link" type="button">
          Spam-Schutz aktivieren
        </button>
        <div id="turnstile-widget"></div>
      </div>
    )}
    <p class="privacy-notice">
      Bitte geben Sie in diesem Kontaktformular keine sensiblen persönlichen
      Informationen an, insbesondere keine Angaben zu Ihrer Gesundheit,
      Diagnosen oder psychischen Beschwerden. Das Formular dient ausschließlich
      der allgemeinen Kontaktaufnahme.
    </p>
    <p class="form-privacy">
      Hinweise zur Verarbeitung Ihrer Angaben finden Sie in der{" "}
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/datenschutz/`}>
        Datenschutzerklärung
      </a>
      .
    </p>
    <button id="submit-contact" class="button" type="submit" disabled>
      Anfrage senden
    </button>
    <p id="form-status" class="form-status" role="status" tabindex="-1"></p>
  </form>
</section>

<script>
  import "../scripts/contact";
</script>
