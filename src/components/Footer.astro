---
import { profile } from "../content/site";
import { path } from "../lib/paths";
---

<footer class="site-footer wrap">
  <a class="footer-brand" href={path()}>
    {profile.name}
    <span>{profile.role}</span>
  </a>
  <p>© {new Date().getFullYear()}</p>
  <div class="footer-social" aria-label="Berufliche und wissenschaftliche Profile">
    <a href="https://www.linkedin.com/in/georg-leistenschneider-3b72b51a9/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href="https://scholar.google.com/citations?hl=en&amp;user=pEXVE18AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
  </div>
  <nav aria-label="Rechtliche Informationen">
    <a href={path("impressum/")}>Impressum</a>
    <a href={path("datenschutz/")}>Datenschutz</a>
  </nav>
</footer>
