---
import { profile, services } from "../content/site";
import { path } from "../lib/paths";
interface Props {
  hero?: boolean;
}
const { hero = false } = Astro.props;
---

<header class:list={["site-header", { "on-hero": hero }]}>
  <a
    class="small-brand"
    href={path()}
    aria-label={`${profile.name} – Startseite`}
  >
    G<span class="brand-dot">.</span>
  </a>
  <details class="menu">
    <summary aria-label="Menü öffnen oder schließen">
      <span class="menu-word">Menü</span>
      <span class="menu-icon" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </summary>
    <nav aria-label="Hauptnavigation">
      <a href={path("#ansatz")}>Über mich</a>
      {services.map((service) => (
        <a href={path(`#${service.id}`)}>{service.label}</a>
      ))}
      <a href={path("#kontakt")} class="menu-contact">
        Kontakt aufnehmen
      </a>
    </nav>
  </details>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".menu").forEach((menu) => {
    const header = menu.closest<HTMLElement>(".site-header");
    const panel = menu.querySelector<HTMLElement>("nav");
    const positionPanel = () => {
      if (!header || !panel || !header.classList.contains("on-hero")) return;
      const summary = menu.querySelector<HTMLElement>("summary");
      if (!summary) return;
      // Anchor the open panel to the hamburger/cross at every scroll position.
      const trigger = summary.getBoundingClientRect();
      const top = Math.max(0, trigger.bottom + 12);
      panel.style.top = top + "px";
      panel.style.maxHeight = Math.max(160, window.innerHeight - top - 12) + "px";
    };
    menu.addEventListener("toggle", positionPanel);
    window.addEventListener("scroll", positionPanel, { passive: true });
    const updateBurgerDock = () => {
      if (!header?.classList.contains("on-hero")) return;
      const summary = menu.querySelector<HTMLElement>("summary");
      if (!summary) return;
      const shouldDock = header.getBoundingClientRect().top + summary.offsetTop <= 9;
      document.body.classList.toggle("burger-is-docked", shouldDock);
      // Ease the icon outward between its own docking point and the navigation docking.
      const serviceNav = document.querySelector<HTMLElement>(".hero-services");
      const placeholder = document.querySelector<HTMLElement>(".hero-services-placeholder");
      const navTop = placeholder?.isConnected
        ? placeholder.getBoundingClientRect().top
        : serviceNav?.getBoundingClientRect().top ?? 0;
      const distance = Math.max(1, navTop - 9);
      const progress = document.body.classList.contains("nav-is-docked")
        ? 1
        : Math.max(0, Math.min(1, 1 - distance / Math.max(window.innerHeight * 0.32, 1)));
      summary.style.setProperty("--burger-drift", String(progress));
    };
    window.addEventListener("scroll", updateBurgerDock, { passive: true });
    window.addEventListener("resize", updateBurgerDock);
    updateBurgerDock();

    window.addEventListener("resize", positionPanel);
    const contactLink = menu.querySelector<HTMLAnchorElement>(".menu-contact");
    contactLink?.addEventListener("click", (event) => {
      const target = document.querySelector<HTMLElement>("#kontakt");
      if (!target || location.pathname !== contactLink.pathname) return;
      event.preventDefault();
      menu.open = false;
      const start = window.scrollY;
      const destination = target.getBoundingClientRect().top + start - 70;
      const delta = destination - start;
      const duration = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 1700;
      if (!duration) {
        window.scrollTo(0, destination);
        history.pushState(null, "", "#kontakt");
        return;
      }
      const began = performance.now();
      const animate = (now: number) => {
        const progress = Math.min(1, (now - began) / duration);
        const eased = 0.5 - Math.cos(Math.PI * progress) / 2;
        window.scrollTo({ top: start + delta * eased, behavior: "instant" });
        if (progress < 1) requestAnimationFrame(animate);
        else history.pushState(null, "", "#kontakt");
      };
      requestAnimationFrame(animate);
    });
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.contains(event.target))
        menu.open = false;
    });
  });
</script>
