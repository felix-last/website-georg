---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  service: {
    id: string;
    label: string;
    title: string;
    text: string;
    note: string;
  };
  index: number;
  image?: ImageMetadata;
  publicImage?: string;
  alt?: string;
}
const { service, index, image, publicImage, alt = "" } = Astro.props;
---

<section
  id={service.id}
  class:list={[
    "service-section",
    { reverse: index % 2 !== 0, "has-image": !!(image || publicImage), "sport-feature": service.id === "sportpsychologie" },
  ]}
  aria-labelledby={`${service.id}-title`}
>
  {image || publicImage ? (
    <div class="service-image">
      {image ? <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      /> : <img src={publicImage} alt={alt} loading="lazy" decoding="async" width="1024" height="1536" />}
    </div>
  ) : (
    <div class="service-art" aria-hidden="true">
      <span>0{index + 1}</span>
      <div class="art-lines"></div>
    </div>
  )}
  <div class="service-copy">
    <p class="eyebrow line-label">{service.label}</p>
    <h2 id={`${service.id}-title`}>
      {service.title.split("\n").map((line, lineIndex) => (
        <span class:list={{ "sport-grow": service.id === "sportpsychologie" && lineIndex === 1, "sport-lead": service.id === "sportpsychologie" && lineIndex === 0 }}>{service.id === "sportpsychologie" && lineIndex === 0 ? <><span class="sport-accent">Ganzheitlich</span> trainieren.</> : service.id === "sportpsychologie" && lineIndex === 1 ? <>Größer <span class="sport-accent">denken.</span></> : line} </span>
      ))}
    </h2>
    {service.id === "notfallpsychologie" ? (
      <>
        <p class="service-description">Wenn es draußen ganz still wird, wird es drinnen ganz laut.</p>
        <div class="service-details emergency-audiences">
          <h3>Für Betroffene:</h3>
          <p>Psychologische Unterstützung nach außergewöhnlichen Belastungsereignissen, beispielsweise bei:</p>
          <ul>
            <li>Unfällen und Unglücksfällen</li>
            <li>schweren Erkrankungen und medizinischen Krisen</li>
            <li>Tod, Trauer und Suizid</li>
            <li>Gewalt, Bedrohungen und Überfällen</li>
            <li>Naturkatastrophen und anderen Krisenereignissen</li>
          </ul>
          <h3>Für Einsatzkräfte:</h3>
          <p>Psychologische Begleitung für Einsatzkräfte und Angehörige von Behörden und Organisationen mit Sicherheitsaufgaben (BOS), insbesondere nach:</p>
          <ul>
            <li>besonders belastenden Einsätzen</li>
            <li>Konfrontation mit Tod, schweren Verletzungen oder Gewalt</li>
            <li>außergewöhnlichen Einsatzlagen und Großschadensereignissen</li>
            <li>psychisch belastenden beruflichen Situationen</li>
          </ul>
          <p class="emergency-scope">Je nach Situation umfasst die Unterstützung psychologische Akutintervention, Stabilisierung, Nachsorge und Beratung sowie die Vermittlung weiterführender Hilfen.</p>
        </div>
      </>
    ) : service.id === "neuropsychologie" ? (
      <p class="service-description">
        In Freiburg im Breisgau biete ich (neuro-)psychologische Begutachtungen an. Im Rahmen von Zustands- und Zusammenhangsbegutachtungen beurteile ich insbesondere die kognitive Leistungsfähigkeit, arbeitsbezogene Einschränkungen und Befunde, die für die Einschätzung einer Minderung der Erwerbsfähigkeit (MdE) relevant sein können. Durch meine bisherige berufliche Tätigkeit verfüge ich über Erfahrung mit Post-COVID, Schädel-Hirn-Traumata und neurologischen Erkrankungen. Die Untersuchungen erfolgen mit standardisierten psychologischen und neuropsychologischen Verfahren. Dabei orientiere ich mich an der Leitlinie zur neuropsychologischen Begutachtung nach <a href="https://econtent.hogrefe.com/doi/10.1024/1016-264X/a000165" target="_blank" rel="noopener noreferrer">Neumann-Zielke et al. (2015)</a>.
      </p>
    ) : <p class="service-description">{service.text}</p>}
    {service.id === "beratung" ? (
      <p class="content-note counseling-disclaimer">
        Psychologische Beratung ist <u>keine Psychotherapie</u> und ersetzt keine psychotherapeutische oder psychiatrische Behandlung.
      </p>
    ) : service.id === "notfallpsychologie" ? (
      <p class="content-note emergency-disclaimer">Dieses notfallpsychologische Angebot ist <strong><u>keine Psychotherapie</u></strong> und ersetzt keine psychotherapeutische oder psychiatrische Behandlung. Es handelt sich nicht um einen Notfalldienst. Bei akuter Gefahr wählen Sie <a href="tel:112">112</a>; bei dringendem, nicht lebensbedrohlichem medizinischem Hilfebedarf außerhalb regulärer Sprechzeiten erreichen Sie den ärztlichen Bereitschaftsdienst unter <a href="tel:116117">116117</a>.</p>
    ) : service.note ? (
      <p class="content-note">{service.note}</p>
    ) : null}

    {service.id === "sportpsychologie" && (
      <div class="sport-offer">
        <h3>Formate</h3>
        <ul class="sport-formats">
          <li>Einzeltraining</li>
          <li>Mannschaftstraining</li>
          <li>Trainer:innenberatung</li>
          <li>Themenworkshops</li>
        </ul>
        <h3>Themen</h3>
        <p class="sport-topics">Psychoedukation · Zielsetzung · <span class="topic-emphasis">Achtsamkeit</span> · Aktivierung · Kognitive Fähigkeiten · Entspannung · Selbstgesprächsregulation · <span class="topic-emphasis">Visualisierung</span> · <span class="topic-emphasis">Selbstvertrauen</span> · Erholungs- und Belastungsmanagement · Wettkampfvorbereitung und -begleitung · <span class="topic-emphasis">Routinen</span> · Verletzungsmanagement · <span class="topic-emphasis">Concussion-Screening</span></p>
      </div>
    )}
    {service.id === "neuropsychologie" && (
      <div class="service-details">
        <h3>Auftraggeber:innen</h3>
        <ul>
          <li>Sozial-, Arbeits- und Zivilgerichte</li>
          <li>Berufsgenossenschaften und weitere Träger der gesetzlichen Unfallversicherung</li>
          <li>Private Versicherungen, insbesondere Unfall-, Berufsunfähigkeits-, Lebens-, Haftpflicht- und Krankenversicherungen</li>
          <li>Versorgungsämter und weitere Behörden</li>
        </ul>
      </div>
    )}
    {service.id === "unternehmen" && (
      <div class="service-details">
        <h3>Beratungsthemen</h3>
        <ul>
          <li>Führungskräfteentwicklung und Führung unter Druck</li>
          <li>Kommunikation und Konfliktmanagement</li>
          <li>Krisenmanagement</li>
          <li>Stress, Belastung und Erholung</li>
          <li>Mentale Leistungsfähigkeit</li>
          <li>Teamdynamik</li>
          <li>Resilienz und Change Management</li>
        </ul>
      </div>
    )}
    <div class="service-bottom">
      <a class="button" href="#kontakt">
        {service.id === "neuropsychologie" ? "Gutachten anfragen" : service.id === "unternehmen" ? "Workshop anfragen" : "Erstgespräch anfragen"}
      </a>

    </div>
  </div>
</section>
