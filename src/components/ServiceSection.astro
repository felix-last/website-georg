---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  service: {
    id: string;
    label: string;
    title: string;
    text: string;
    note: string;
    keywords: string[];
  };
  index: number;
  image?: ImageMetadata;
  alt?: string;
}
const { service, index, image, alt = "" } = Astro.props;
---

<section
  id={service.id}
  class:list={[
    "service-section",
    { reverse: index % 2 !== 0, "has-image": !!image },
  ]}
  aria-labelledby={`${service.id}-title`}
>
  {image ? (
    <div class="service-image">
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
      <span class="image-index" aria-hidden="true">
        0{index + 1} / 05
      </span>
    </div>
  ) : (
    <div class="service-art" aria-hidden="true">
      <span>0{index + 1}</span>
      <div class="art-lines"></div>
      <small>{service.keywords.join(" · ")}</small>
    </div>
  )}
  <div class="service-copy">
    <p class="eyebrow line-label">{service.label}</p>
    <h2 id={`${service.id}-title`}>
      {service.title.split("\n").map((line) => (
        <span>{line} </span>
      ))}
    </h2>
    <p class="service-description">{service.text}</p>
    <p class="content-note">{service.note}</p>
    <div class="service-bottom">
      <a class="button" href="#kontakt">
        Erstgespräch anfragen <span aria-hidden="true">⟶</span>
      </a>
      <p class="keywords">
        {service.keywords.map((word) => (
          <span>{word}</span>
        ))}
        <i aria-hidden="true"></i>
      </p>
    </div>
  </div>
</section>
