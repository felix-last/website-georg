---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  service: {
    id: string;
    label: string;
    title: string;
    text: string;
    note: string;
  };
  index: number;
  image?: ImageMetadata;
  alt?: string;
}
const { service, index, image, alt = "" } = Astro.props;
---

<section
  id={service.id}
  class:list={[
    "service-section",
    { reverse: index % 2 !== 0, "has-image": !!image, "sport-feature": service.id === "sportpsychologie" },
  ]}
  aria-labelledby={`${service.id}-title`}
>
  {image ? (
    <div class="service-image">
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="service-art" aria-hidden="true">
      <span>0{index + 1}</span>
      <div class="art-lines"></div>
    </div>
  )}
  <div class="service-copy">
    <p class="eyebrow line-label">{service.label}</p>
    <h2 id={`${service.id}-title`}>
      {service.title.split("\n").map((line, lineIndex) => (
        <span class:list={{ "sport-grow": service.id === "sportpsychologie" && lineIndex === 1, "sport-lead": service.id === "sportpsychologie" && lineIndex === 0 }}>{service.id === "sportpsychologie" && lineIndex === 1 ? <><span class="sport-accent">Größer</span> denken.</> : line} </span>
      ))}
    </h2>
    <p class="service-description">{service.text}</p>
    {service.id === "beratung" ? (
      <p class="content-note counseling-disclaimer">
        Psychologische Beratung ist <u>keine Psychotherapie</u> und ersetzt keine psychotherapeutische oder psychiatrische Behandlung.
      </p>
    ) : service.note ? (
      <p class="content-note">{service.note}</p>
    ) : null}

    {service.id === "sportpsychologie" && (
      <div class="sport-offer">
        <h3>Formate</h3>
        <ul class="sport-formats">
          <li>Einzeltraining</li>
          <li>Mannschaftstraining</li>
          <li>Trainer:innenberatung</li>
          <li>Themenworkshops</li>
        </ul>
        <h3>Themen</h3>
        <p class="sport-topics">Psychoedukation · Zielsetzung · Achtsamkeit · Kognitive Fähigkeiten · Entspannung · Selbstgesprächsregulation · Visualisierung · Selbstvertrauen · Erholungs- und Belastungsmanagement · Wettkampfvorbereitung und -begleitung · Routinen · Verletzungsmanagement · Concussion-Screening</p>
      </div>
    )}
    <div class="service-bottom">
      <a class="button" href="#kontakt">
        Erstgespräch anfragen{service.id !== "sportpsychologie" && <span aria-hidden="true"> ⟶</span>}
      </a>

    </div>
  </div>
</section>
