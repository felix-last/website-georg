---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/editorial.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServiceSection from "../components/ServiceSection.astro";
import ContactForm from "../components/ContactForm.astro";
import { profile, services } from "../content/site";
import forest from "../assets/forest.png";
import lighthouse from "../assets/Misty Beacon Over Calm Seas.png";
import mountains from "../assets/mountains.png";
---

<Layout>
  <main id="inhalt">
    <section class="hero" aria-labelledby="hero-title">
      <Image
        class="hero-image"
        src={forest}
        alt=""
        widths={[640, 1024, 1536, 1920]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-shade"></div>
      <Header hero />
      <div class="hero-content wrap">
        <p class="eyebrow hero-pretitle">Ein neuer Blick. Ein eigener Weg.</p>
        <h1 id="hero-title"><a class="hero-name-link" href="#ueber-mich" aria-label="Mehr über Georg erfahren">{profile.name}</a></h1>
        <p class="hero-role">{profile.role}</p>
        <nav class="hero-services" aria-label="Leistungsbereiche">
          {services.map((service) => (
            <a href={`#${service.id}`}>{service.label}</a>
          ))}
          <details class="docked-menu">
            <summary aria-label="Menü öffnen oder schließen" title="Menü">
              <span class="docked-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            </summary>
            <div class="docked-menu-panel">
              <a href="#ueber-mich">Über mich</a>
              {services.map((service) => <a href={`#${service.id}`}>{service.label}</a>)}
              <a href="#kontakt">Kontakt aufnehmen ↗</a>
            </div>
          </details>
        </nav>
      </div>
      <a class="scroll-cue scroll-cue-delayed" href="#ueber-mich" aria-label="Mehr über mich erfahren">
        <span></span>
        <span aria-hidden="true">↓</span>
      </a>
      <p class="hero-location">
        <a href="https://maps.app.goo.gl/KMi3AYGXQVRkcWdo7" target="_blank" rel="noopener noreferrer" aria-label="Freiburg auf Google Maps öffnen (neuer Tab)">{profile.location}</a>
        <span aria-hidden="true"></span>
      </p>
    </section>

    <section id="ueber-mich" class="intro wrap" aria-labelledby="about-title">
      <div class="about-lead">
        <p class="eyebrow">Über mich</p>
        <h2 id="about-title"><span>Sport.</span><span>Notfall.</span><span>Neuro.</span></h2>
        <p>Ich bin Georg Schmeistenbeißer und Psychologe in Freiburg im Breisgau. Meine Tätigkeit verteilt sich auf drei Bereiche: die Sportpsychologie, die Notfallpsychologie und die Neuropsychologie.</p>
      </div>
      <figure class="intro-image">
        <img
          src={`${import.meta.env.BASE_URL}images/Warm%20Modern%20Portrait%20in%20a%20Cosy%20Interior.png`}
          alt="KI-generiertes Platzhalterporträt eines jungen Mannes in einem hellen Innenraum"
          loading="lazy"
          decoding="async"
          width="1536"
          height="1024"
        />
        <figcaption>Platzhalterporträt · KI-generiert</figcaption>
      </figure>
      <div class="intro-copy">
        <p>Ich befinde mich in der Weiterbildung zum Fachpsychologen für <strong>Sportpsychologie</strong> und kooperiere dabei mit dem Olympiastützpunkt Hochschwarzwald in der Betreuung von Athlet*innen. Darüber hinaus biete ich mentales Training im Einzel- und Teamsetting an. Durch meinen klinisch-neuropsychologischen Hintergrund berücksichtige ich neben der Leistungsoptimierung auch präventive und gesundheitspsychologische Themen.</p>
        <p>Außerdem bilde ich mich zum Fachpsychologen für <strong>Notfallpsychologie</strong> weiter. Hier biete ich psychologische Begleitung nach potenziell traumatischen Ereignissen an. Im Mittelpunkt stehen die emotionale Stabilisierung, das Wiedererlangen der Handlungsfähigkeit sowie gegebenenfalls die Vermittlung weiterführender Hilfsangebote.</p>
        <p><strong>Neuropsychologisch</strong> arbeite ich derzeit an der Caritas Reha-Klinik Stöckenhöfe bei Freiburg im Breisgau. Zudem erstelle ich selbstständig psychologische und neuropsychologische Gutachten zu Fragen der kognitiven Leistungsfähigkeit.</p>
        <p>In meiner Arbeit ist mir ein ganzheitlicher Blick wichtig. Ich betrachte den Menschen mit seinen unterschiedlichen Facetten und beziehe Erfahrungen aus allen drei Tätigkeitsbereichen ein – unabhängig davon, in welchem Bereich der jeweilige Auftrag liegt. Mein wissenschaftlicher Hintergrund ist dabei die Grundlage für den Anspruch, meine Methoden evidenzbasiert auszuwählen und kontinuierlich am aktuellen Forschungsstand auszurichten.</p>
        <p class="content-note about-therapy-notice">Ich bin kein Psychologischer Psychotherapeut und biete daher <strong><u>keine Psychotherapie</u></strong> an. Mein Angebot ersetzt keine psychotherapeutische oder psychiatrische Behandlung.</p>
      </div>

      <div
        id="vitae"
        class="profile-section"
        aria-labelledby="profile-title"
      >
        <h2 id="profile-title" class="eyebrow line-label">Vitae</h2>
        <div class="timeline" tabindex="0" role="region" aria-label="Beruflicher Werdegang, horizontal scrollbar">
          {[
            ["Berlin", "Geboren in Berlin"],
            ["Seit 2018", "Trainer C Leistungssport Segeln"],
            ["2020", "Zertifikat Sexualmedizin · Universitätsklinikum Schleswig-Holstein"],
            ["2023", "M.Sc. Psychologie · Humboldt-Universität zu Berlin"],
            ["Seit 2023", "Psychedelic Substances Research Group"],
            ["Seit 2023", "Angestrebte Promotion · Charité Berlin (laufend)"],
            ["Seit 2024", "Neuropsychologischer Gutachter"],
            ["Seit 2026", "Neuropsychologe · cts Reha-Klinik Stöckenhöfe"],
            ["Seit 2026", "Sportpsychologe in Ausbildung"],
            ["Seit 2026", "Notfallpsychologe in Ausbildung"],
          ].map(([year,description]) => (
            <div class="timeline-entry">
              <span>{year}</span>
              <p>{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="services wrap">
      {services.map((service, index) => (
        <ServiceSection
          service={service}
          index={index}
          image={service.id === "notfallpsychologie" ? lighthouse : undefined}
          publicImage={
            service.id === "sportpsychologie"
              ? `${import.meta.env.BASE_URL}images/Alpine%20Freeride%20Through%20the%20Couloir.png`
              : service.id === "beratung"
                ? `${import.meta.env.BASE_URL}images/Sunlit%20Scandi%20Chair%20and%20Shadows.png`
                : service.id === "neuropsychologie"
                  ? `${import.meta.env.BASE_URL}images/Sunlit%20Scandi%20Chair%20and%20Shadows.png`
                  : undefined
          }
          alt={
            service.id === "sportpsychologie"
              ? "Skifahrerin oder Skifahrer in einer steilen alpinen Wettkampfabfahrt; KI-generiertes Stimmungsbild"
              : service.id === "beratung"
                ? "Leerer Holzstuhl in einem hellen Raum mit geometrischen Fensterschatten; KI-generiertes Stimmungsbild"
                : service.id === "neuropsychologie"
                  ? "Heller Raum mit einem Holzstuhl und geometrischen Fensterschatten; KI-generiertes Stimmungsbild"
                  : "Ruhige Meeresfläche im Nebel mit entferntem Leuchtturm; KI-generiertes Stimmungsbild"
          }
        />
      ))}
    </div>

    <ContactForm />
  </main>
  <Footer />
</Layout>

<script>
  const scrollCue = document.querySelector<HTMLElement>(".scroll-cue-delayed");
  // Both hero links share one cancellable animation, independent of native anchors.
  const heroNameLink = document.querySelector<HTMLAnchorElement>(".hero-name-link");
  let aboutScrollFrame = 0;
  const gentleAboutScroll = (event: MouseEvent) => {
    event.preventDefault();
    const target = document.getElementById("ueber-mich");
    if (!target) return;
    cancelAnimationFrame(aboutScrollFrame);
    const start = window.scrollY;
    const destination = Math.max(0, target.getBoundingClientRect().top + start - 105);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.documentElement.classList.add("programmatic-scroll");
    if (reduced) {
      window.scrollTo(0, destination);
      document.documentElement.classList.remove("programmatic-scroll");
      history.replaceState(null, "", "#ueber-mich");
      return;
    }
    const started = performance.now();
    const duration = 2400;
    const animate = (now: number) => {
      const t = Math.min(1, (now - started) / duration);
      const eased = t * t * t * (t * (t * 6 - 15) + 10);
      window.scrollTo(0, start + (destination - start) * eased);
      if (t < 1) aboutScrollFrame = requestAnimationFrame(animate);
      else {
        document.documentElement.classList.remove("programmatic-scroll");
        history.replaceState(null, "", "#ueber-mich");
      }
    };
    aboutScrollFrame = requestAnimationFrame(animate);
  };
  scrollCue?.addEventListener("click", gentleAboutScroll);
  heroNameLink?.addEventListener("click", gentleAboutScroll);
  document.querySelector<HTMLAnchorElement>(".mobile-monogram")?.addEventListener("click", gentleAboutScroll);
  // On mobile, retain the GL mark once the hero name crosses the top bar.
  const updateMobileNameDock = () => {
    if (window.matchMedia("(max-width: 760px)").matches) {
      const name = document.getElementById("hero-title");
      const passed = !!name && name.getBoundingClientRect().bottom <= 60;
      document.body.classList.toggle("mobile-name-passed", passed);
    } else {
      document.body.classList.remove("mobile-name-passed");
    }
  };
  window.addEventListener("scroll", updateMobileNameDock, { passive: true });
  window.addEventListener("resize", updateMobileNameDock);
  updateMobileNameDock();
  const hero = document.querySelector<HTMLElement>(".hero");
  if (scrollCue && hero) {
    // Reveal after four seconds; then let the arrow respond to scrolling.
    window.setTimeout(() => scrollCue.classList.add("is-visible"), 2000);
    const updateScrollCue = () => {
      const progress = Math.min(1, Math.max(0, window.scrollY / Math.max(hero.offsetHeight, 1)));
      scrollCue.style.setProperty("--scroll-progress", String(progress));
    };
    window.addEventListener("scroll", updateScrollCue, { passive: true });
    window.addEventListener("resize", updateScrollCue);
    updateScrollCue();
  }
  const nav = document.querySelector<HTMLElement>(".hero-services");
  const originalParent = nav?.parentElement;
  const placeholder = document.createElement("div");
  placeholder.className = "hero-services-placeholder";

  if (nav && originalParent) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>(":scope > a"));
    const dockedMenu = nav.querySelector<HTMLDetailsElement>(".docked-menu");
    dockedMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { if (dockedMenu) dockedMenu.open = false; }));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape" && dockedMenu?.open) { dockedMenu.open = false; dockedMenu.querySelector("summary")?.focus(); } });
    document.addEventListener("click", (event) => { if (dockedMenu?.open && event.target instanceof Node && !dockedMenu.contains(event.target)) dockedMenu.open = false; });
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let currentAnimations: Animation[] = [];

    const updateNavigation = () => {
      if (window.matchMedia("(max-width: 760px)").matches) {
        // On mobile, keep the categories in the hero: they visually converge
        // on the hamburger instead of becoming a second sticky navigation.
        if (nav.classList.contains("is-docked")) {
          originalParent.insertBefore(nav, placeholder);
          placeholder.remove();
          nav.classList.remove("is-docked");
        }
        const rect = nav.getBoundingClientRect();
        // Use the untransformed nav box and clamp rubber-band overscroll to zero.
        // The animation begins only after actual downward page scrolling.
        const scroll = Math.max(0, window.scrollY);
        const start = Math.max(0, nav.getBoundingClientRect().top + scroll - window.innerHeight * .44);
        const distance = Math.max(1, window.innerHeight * .44 - 62);
        const progress = Math.max(0, Math.min(1, (scroll - start) / distance));
        nav.style.setProperty("--mobile-collapse", String(progress));
        // The last category catches up with the others near the burger.
        // Reveal the full-width bar at that point, rather than waiting for
        // the original category container to leave the viewport.
        const active = document.body.classList.contains("mobile-name-passed");
        document.body.classList.toggle("mobile-nav-active", active);
        document.body.classList.remove("nav-is-docked");
        return;
      }
      document.body.classList.remove("mobile-nav-active");
      nav.style.removeProperty("--mobile-collapse");
      const docked = placeholder.isConnected
        ? placeholder.getBoundingClientRect().top <= 0
        : nav.getBoundingClientRect().top <= 0;
      if (docked === nav.classList.contains("is-docked")) return;

      currentAnimations.forEach((animation) => animation.cancel());
      currentAnimations = [];
      const before = links.map((link) => link.getBoundingClientRect());

      if (docked) {
        originalParent.insertBefore(placeholder, nav);
        document.body.appendChild(nav);
        nav.classList.add("is-docked");
      } else {
        originalParent.insertBefore(nav, placeholder);
        placeholder.remove();
        nav.classList.remove("is-docked");
      }

      document.body.classList.toggle("nav-is-docked", docked);
      if (dockedMenu) dockedMenu.open = false;
      if (reducedMotion.matches) return;

      const after = links.map((link) => link.getBoundingClientRect());
      links.forEach((link, index) => {
        const dx = before[index].left - after[index].left;
        const dy = before[index].top - after[index].top;
        const scale = before[index].width / Math.max(after[index].width, 1);
        currentAnimations.push(
          link.animate(
            [
              { transform: `translate(${dx}px, ${dy}px) scale(${scale})` },
              { transform: "translate(0, 0) scale(1)" },
            ],
            { duration: 440, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
          ),
        );
      });
    };

    window.addEventListener("scroll", updateNavigation, { passive: true });
    window.addEventListener("resize", updateNavigation);
    updateNavigation();
  }
</script>

<script>
  // Mobile typography uses measurements rather than guessed viewport units.
  const fitEmergencyTitle = () => {
    if (window.innerWidth > 760) return;
    const section = document.getElementById("notfallpsychologie");
    const subtitle = section?.querySelector<HTMLElement>(".service-copy h2 > span:last-child");
    const firstLine = section?.querySelector<HTMLElement>(".service-copy h2 > span:first-child");
    const image = section?.querySelector<HTMLElement>(".service-image");
    if (!subtitle || !firstLine || !image) return;
    subtitle.style.fontSize = "20px";
    const naturalWidth = subtitle.scrollWidth;
    const available = image.getBoundingClientRect().width;
    if (naturalWidth > 0 && available > 0) {
      const fitted = `${Math.max(12, 20 * available / naturalWidth)}px`;
      subtitle.style.fontSize = fitted;
      firstLine.style.fontSize = fitted;
    }
  };
  const updateSportGrowth = () => {
    const section = document.getElementById("sportpsychologie");
    const word = section?.querySelector<HTMLElement>(".sport-grow-word");
    const thinking = section?.querySelector<HTMLElement>(".sport-think-word");
    if (!section || !word || !thinking || window.innerWidth > 760) return;
    const rect = section.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, (window.innerHeight - rect.top) / (window.innerHeight + rect.height * .6)));
    const scale = 1 + progress * 1.8;
    word.style.transform = `scale(${scale})`;
    thinking.style.transform = `translateX(${word.offsetWidth * (scale - 1)}px)`;
  };
  window.addEventListener("scroll", updateSportGrowth, { passive: true });
  window.addEventListener("resize", updateSportGrowth);
  updateSportGrowth();
  window.addEventListener("resize", fitEmergencyTitle);
  document.fonts?.ready.then(fitEmergencyTitle);
  fitEmergencyTitle();
</script>

<script>
  // Reveal content once as it enters the viewport; never hide it again.
  const revealTargets = document.querySelectorAll<HTMLElement>(
    ".intro-copy, .intro-image, .profile-section, .service-section .service-image, .service-section .service-art, .service-section .service-copy, .contact-intro, #contact-form",
  );
  const reducedMotionReveal = window.matchMedia("(prefers-reduced-motion: reduce)");
  if ("IntersectionObserver" in window && !reducedMotionReveal.matches) {
    const observer = new IntersectionObserver(
      (entries, instance) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            instance.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -35px 0px" },
    );
    revealTargets.forEach((element) => {
      element.classList.add("reveal-item");
      if (element.getBoundingClientRect().top < window.innerHeight * 0.9) {
        element.classList.add("is-revealed");
      } else {
        observer.observe(element);
      }
    });
  }

  // CTAs receive their own delayed reveal after the surrounding content.
  const ctaTargets = document.querySelectorAll<HTMLElement>(".service-bottom");
  if ("IntersectionObserver" in window && !reducedMotionReveal.matches) {
    const ctaObserver = new IntersectionObserver((entries, instance) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("cta-visible");
        instance.unobserve(entry.target);
      });
    }, { threshold: 0.1, rootMargin: "0px 0px -20px 0px" });
    ctaTargets.forEach((cta) => {
      cta.classList.add("cta-reveal");
      ctaObserver.observe(cta);
    });
  }
</script>

<script>
  // Start the staggered bold dissolve only once the topic list is visible.
  const topics = document.querySelector<HTMLElement>(".sport-topics");
  if (topics && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          topics.classList.add("topic-emphasis-active");
          topics.querySelectorAll<HTMLElement>(".topic-emphasis").forEach((word, index) => {
            window.setTimeout(() => word.classList.add("is-bold"), index * 1100);
          });
          observer.disconnect();
        }
      }, { threshold: 0.35 });
      observer.observe(topics);
    } else {
      topics.classList.add("topic-emphasis-active");
      topics.querySelectorAll<HTMLElement>(".topic-emphasis").forEach((word, index) => {
        window.setTimeout(() => word.classList.add("is-bold"), index * 1100);
      });
    }
  }
</script>

<script>
  // Category links: land a little lower, with gentle acceleration and braking.
  const categoryIds = new Set(["sportpsychologie", "notfallpsychologie", "neuropsychologie"]);
  let categoryScrollFrame = 0;
  const cancelCategoryScroll = () => cancelAnimationFrame(categoryScrollFrame);
  window.addEventListener("wheel", cancelCategoryScroll, { passive: true });
  window.addEventListener("touchstart", cancelCategoryScroll, { passive: true });
  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element
      ? event.target.closest<HTMLAnchorElement>("a[href]")
      : null;
    if (!link || !link.hash || link.origin !== window.location.origin ||
        link.pathname !== window.location.pathname) return;
    const id = decodeURIComponent(link.hash.slice(1));
    if (!categoryIds.has(id) && !(id === "kontakt" && link.matches(".service-bottom .button, .mobile-contact-cta"))) return;
    const target = document.getElementById(id);
    if (!target) return;
    event.preventDefault();
    cancelCategoryScroll();
    const start = window.scrollY;
    // Align the top of the actual image, not the section's outer border or padding.
    const isContact = id === "kontakt";
    const visual = isContact ? null : target.querySelector<HTMLElement>(".service-image, .service-art");
    const offset = isContact ? (window.innerWidth <= 760 ? 85 : 105) : (window.innerWidth <= 760 ? 90 : 105);
    const anchor = visual ?? target;
    const targetY = () => Math.max(0, anchor.getBoundingClientRect().top + window.scrollY - offset);
    const destination = targetY();
    const distance = destination - start;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.scrollTo({ top: destination, behavior: "instant" });
      history.pushState(null, "", link.hash);
      return;
    }
    const duration = isContact ? 2400 : Math.min(1900, Math.max(1100, Math.abs(distance) * 0.55));
    const started = performance.now();
    const animate = (now: number) => {
      const t = Math.min(1, (now - started) / duration);
      const eased = t * t * t * (t * (t * 6 - 15) + 10);
      // Recalculate the image position as the sticky navigation changes layout.
      const currentDestination = targetY();
      window.scrollTo({ top: start + (currentDestination - start) * eased, behavior: "instant" });
      if (t < 1) categoryScrollFrame = requestAnimationFrame(animate);
      else {
        window.scrollTo({ top: targetY(), behavior: "instant" });
        history.pushState(null, "", link.hash);
      }
    };
    categoryScrollFrame = requestAnimationFrame(animate);
  });
</script>
